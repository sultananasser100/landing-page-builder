# Postgres connection (docker-compose.yml exposes Postgres on host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/landing_builder"

# Admin login
ADMIN_EMAIL="you@example.com"
# bcrypt hash of your password. Generate the line with: npm run auth:hash-password
# (it escapes each $ as \$, which is required in .env files)
ADMIN_PASSWORD_HASH="paste-the-output-of-npm-run-auth-hash-password-here"

# Session signing secret: at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"
