# Copy to .env (and .env.test for the test database), then fill in real values.

# Postgres connection (docker-compose.yml exposes Postgres on host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/landing_builder"

# Admin login (used from Phase 3)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# Session signing secret (used from Phase 3): at least 32 random characters
SESSION_SECRET="replace-with-a-long-random-string"
