# Copy to .env (and .env.test for the test database), then fill in real values.

# Postgres connection (docker-compose.yml exposes Postgres on host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/landing_builder"

# Admin login. Generate the hash line with `npm run auth:hash-password`.
# Next.js expands $ in .env files, so each $ in the bcrypt hash must be
# escaped as \$ (the script prints it that way).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# Session signing secret: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs out every session.
SESSION_SECRET="replace-with-a-long-random-string"
