    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
